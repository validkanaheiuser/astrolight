{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astrolight",
  "version": "3.2.0",
  "identifier": "local.astrolight.lucky65",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Astrolight \u00b7 Lucky65",
        "width": 1240,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "backgroundColor": "#10131f",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}